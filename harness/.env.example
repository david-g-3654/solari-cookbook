# Required: one key works for browsers, sandboxes and desktops.
# Get one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional: only needed for the LLM-driven adapters (--adapter stagehand|browser-use).
# The default `scripted` adapter needs no model key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
