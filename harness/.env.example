# Required: one key works for browsers, sandboxes and desktops.
# Get one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional: only needed for the LLM-driven adapters (--adapter stagehand|browser-use).
# The default `scripted` adapter needs no model key. Set ONE of these.
#
# OpenRouter is one key for every model. Pick the model with, e.g.
#   SPLITFLAP_MODEL=openrouter/anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only for --adapter browser-use: browser-use needs Python 3.11+. If the
# `python3` on your PATH is older, point this at a venv that has it, e.g.
#   uv venv --python python3.13 .venv && uv pip install --python .venv/bin/python browser-use
# SPLITFLAP_PYTHON=.venv/bin/python
