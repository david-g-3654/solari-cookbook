{
  "name": "splitflap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-agent eval & replay harness on Solari",
  "bin": {
    "splitflap": "./src/cli.ts"
  },
  "scripts": {
    "splitflap": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/faults.test.ts test/score-and-diff.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:all": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.2",
    "@solarisdk/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@browserbasehq/stagehand": "^4.0.2"
  }
}
